# Copie este arquivo para .env e ajuste os valores. NUNCA suba o .env para o repositório.

# Banco de dados (SQLite por padrão)
DATABASE_URL=sqlite:///./tarefas.db

# Chave secreta usada para assinar os tokens JWT.
# Gere uma com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-gerada

# Validade do token em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origens autorizadas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
